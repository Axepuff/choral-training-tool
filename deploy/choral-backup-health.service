[Unit]
Description=Choral backup health endpoint for local Beszel agent
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/choral-backup/backup-health.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
