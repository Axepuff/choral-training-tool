{
  "name": "choral-training-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --exact-port --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "check:mcp": "node scripts/check-mcp.mjs",
    "agent:queue": "node scripts/agent-queue/runner.mjs",
    "test:agent-queue": "node --test scripts/agent-queue/queue.test.mjs",
    "test:agent-cli": "node --test scripts/agent-queue/codex-config.check.mjs",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:audio": "node --test tests/audio.test.mjs tests/mp4.test.mjs",
    "test:audio:browser": "node tests/audio-browser.mjs",
    "test:auth:browser": "cd backend && CHORAL_BROWSER_TEST=true go test -count=1 ./internal/auth -run TestFrontendBrowser -v"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-mcp": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "storybook": "10.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  }
}
