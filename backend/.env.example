# Export these variables in the shell; the server does not parse dotenv files.
CHORAL_ADDR=127.0.0.1:8080
CHORAL_DATA_DIR=./data
CHORAL_SHUTDOWN_TIMEOUT=15s
# Optional built frontend, served by the same Go listener. Never use the data dir.
CHORAL_STATIC_DIR=../dist
CHORAL_ORIGIN=https://localhost
CHORAL_LOCAL_HTTP=false
